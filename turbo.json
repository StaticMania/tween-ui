{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "registry:build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "registry:build": {
      "env": ["REGISTRY_URL"],
      "outputs": ["registry/**", "public/r/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
